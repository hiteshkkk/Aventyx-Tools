#!/bin/bash
# ─── tmx — Quick tmux session manager ─────────────────────────────────────────
# https://github.com/AventryxCRM/tmx
#
# Usage:
#   tmx              → interactive menu
#   tmx <name>       → attach or create session
#   tmx --install    → install to /usr/local/bin + generate ~/.tmux.conf
#
# Features:
#   • Create, list, attach, kill sessions from one menu
#   • Auto-applies sane defaults (mouse, scrollback, Ctrl+a prefix)
#   • Type a number to attach, or any text to create/attach by name
#   • Zero dependencies (just bash + tmux)

set -euo pipefail

VERSION="1.0.0"

# ─── Configurable defaults ────────────────────────────────────────────────────
TMX_PREFIX="${TMX_PREFIX:-C-a}"           # Ctrl+a (avoids Ctrl+b conflict with Claude Code, emacs, etc.)
TMX_MOUSE="${TMX_MOUSE:-on}"
TMX_SCROLLBACK="${TMX_SCROLLBACK:-5000}"

# ─── Apply settings to tmux server ───────────────────────────────────────────
apply_settings() {
  tmux set-option -g prefix "$TMX_PREFIX" 2>/dev/null
  tmux unbind C-b 2>/dev/null
  tmux bind "$TMX_PREFIX" send-prefix 2>/dev/null
  tmux set-option -g mouse "$TMX_MOUSE" 2>/dev/null
  tmux set-option -g history-limit "$TMX_SCROLLBACK" 2>/dev/null
  tmux set-option -g base-index 1 2>/dev/null
  tmux set-option -g renumber-windows on 2>/dev/null
  tmux set-option -s escape-time 0 2>/dev/null
}

# ─── Generate ~/.tmux.conf ───────────────────────────────────────────────────
generate_conf() {
  cat > "$HOME/.tmux.conf" << 'TMUXCONF'
# ─── Generated by tmx (https://github.com/AventryxCRM/tmx) ───
# Prefix: Ctrl+a (Ctrl+b conflicts with Claude Code, emacs, etc.)
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# ─── Settings ─────────────────────────────────
set -g mouse on
set -g history-limit 5000
set -g default-terminal "screen-256color"
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -s escape-time 0

# ─── Status bar ───────────────────────────────
set -g status-style 'bg=#1a1a2e fg=#e0e0e0'
set -g status-left '#[fg=#1e40af,bold] #S '
set -g status-right '#[fg=#94a3b8] %H:%M '
TMUXCONF
  echo "  ✓ Generated ~/.tmux.conf"
}

# ─── Install command ─────────────────────────────────────────────────────────
if [ "${1:-}" = "--install" ]; then
  echo "Installing tmx..."
  if [ -w /usr/local/bin ]; then
    cp "$0" /usr/local/bin/tmx
    chmod +x /usr/local/bin/tmx
  else
    sudo cp "$0" /usr/local/bin/tmx
    sudo chmod +x /usr/local/bin/tmx
  fi
  echo "  ✓ Installed to /usr/local/bin/tmx"
  generate_conf
  echo "  ✓ Prefix: Ctrl+a | Mouse: on | Scrollback: 5,000"
  echo ""
  echo "  Run 'tmx' to start!"
  exit 0
fi

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
  echo "tmx $VERSION"
  exit 0
fi

# ─── Quick attach/create if name given ────────────────────────────────────────
if [ "${1:-}" != "" ]; then
  if tmux has-session -t "$1" 2>/dev/null; then
    tmux attach -t "$1"
  else
    tmux new-session -d -s "$1" && apply_settings
    tmux attach -t "$1"
  fi
  exit 0
fi

# ─── Interactive menu ─────────────────────────────────────────────────────────
while true; do
  clear
  echo "╔══════════════════════════════════╗"
  echo "║     tmx $VERSION — tmux manager      ║"
  echo "╚══════════════════════════════════╝"
  echo ""

  # List sessions
  sessions=$(tmux list-sessions 2>/dev/null || true)
  if [ -n "$sessions" ]; then
    echo "  Active sessions:"
    echo "  ─────────────────"
    i=1
    while IFS= read -r line; do
      name=$(echo "$line" | cut -d: -f1)
      info=$(echo "$line" | cut -d: -f2-)
      echo "  [$i] $name —$info"
      i=$((i + 1))
    done <<< "$sessions"
    count=$((i - 1))
  else
    echo "  No active sessions."
    count=0
  fi

  echo ""
  echo "  [n] New session       [s] Apply settings"
  echo "  [k] Kill a session    [q] Quit"
  echo ""
  printf "  > "
  read -r choice

  case "$choice" in
    q|Q) exit 0 ;;

    n|N)
      printf "  Session name: "
      read -r name
      if [ -n "$name" ]; then
        tmux new-session -d -s "$name" 2>/dev/null && apply_settings
        tmux attach -t "$name"
      fi
      ;;

    s|S)
      apply_settings
      echo ""
      echo "  ✓ Prefix: Ctrl+a"
      echo "  ✓ Mouse scrolling: ON"
      echo "  ✓ Scrollback buffer: $TMX_SCROLLBACK lines"
      if [ -n "$sessions" ]; then
        while IFS= read -r line; do
          name=$(echo "$line" | cut -d: -f1)
          tmux set-option -t "$name" mouse "$TMX_MOUSE" 2>/dev/null
          tmux set-option -t "$name" history-limit "$TMX_SCROLLBACK" 2>/dev/null
        done <<< "$sessions"
        echo "  ✓ Applied to all active sessions"
      fi
      sleep 1
      ;;

    k|K)
      if [ "$count" -eq 0 ]; then
        echo "  No sessions to kill."
        sleep 1
        continue
      fi
      printf "  Kill which? [1-$count or name]: "
      read -r target
      if [[ "$target" =~ ^[0-9]+$ ]] && [ "$target" -ge 1 ] && [ "$target" -le "$count" ]; then
        name=$(echo "$sessions" | sed -n "${target}p" | cut -d: -f1)
        tmux kill-session -t "$name" 2>/dev/null && echo "  ✓ Killed: $name"
      else
        tmux kill-session -t "$target" 2>/dev/null && echo "  ✓ Killed: $target"
      fi
      sleep 1
      ;;

    [1-9]|[1-9][0-9])
      if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$count" ]; then
        name=$(echo "$sessions" | sed -n "${choice}p" | cut -d: -f1)
        tmux attach -t "$name"
      else
        echo "  Invalid selection."
        sleep 1
      fi
      ;;

    *)
      if [ -n "$choice" ]; then
        if tmux has-session -t "$choice" 2>/dev/null; then
          tmux attach -t "$choice"
        else
          tmux new-session -d -s "$choice" 2>/dev/null && apply_settings
          tmux attach -t "$choice"
        fi
      fi
      ;;
  esac
done
